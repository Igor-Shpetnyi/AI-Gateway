# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_gateway

# Encryption key for provider API keys (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Admin panel
ADMIN_PASSWORD=

# Provider API keys are managed exclusively through the admin panel
# (Providers → Manage keys) — there is no env var path for them.
